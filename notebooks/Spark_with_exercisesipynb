   "source": [
    "data_unique =[]\n",
    "customer_ids_seen = set()\n",
    "for row in data:\n",
    "    if row['Customer_ID'] not in customer_ids_seen:\n",
    "        data_unique.append(row['Customer_ID'])\n",
    "    else:\n",
    "        print(f'duplicate customer id {row['Customer_ID']}')"
